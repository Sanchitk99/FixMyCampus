PORT=5000`

# --- Pick ONE database ---
# Local MongoDB (no TLS issues): install MongoDB Community, start the service, then:
MONGODB_URI=mongodb://127.0.0.1:27017/fixmycampus
# If .env still points at Atlas and `npm run seed` fails with SSL errors, either:
#   • set MONGODB_URI to the local line above, or
#   • run: npm run seed:local   (uses local DB only for that command; MongoDB must be running)
# MongoDB Atlas: paste your connection string from Atlas (mongodb+srv://...)
# If seed fails with SSL/TLS errors:
#   • Atlas → Network Access → add your IP (or 0.0.0.0/0 for dev only)
#   • URL-encode special characters in the password (@ → %40, # → %23, etc.)
#   • Or try another network / disable VPN
# Dev-only if TLS still fails (not for production):
# MONGODB_TLS_INSECURE=true

JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional seed overrides (npm run seed). Log in with these plain passwords — the DB only stores bcrypt hashes.
# SEED_ADMIN_EMAIL=admin@college.edu
# SEED_ADMIN_PASSWORD=admin123
# SEED_STAFF_EMAIL=staff@college.edu
# SEED_STAFF_PASSWORD=staff123
